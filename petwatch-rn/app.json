{
  "expo": {
    "name": "PetWatch",
    "slug": "petwatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.petwatch.app"
    },
    "android": {
      "package": "com.petwatch.app"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your pet profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      ["expo-location", { "locationWhenInUsePermission": "Use your location to find nearby veterinary clinics." }]
    ]
  }
}
